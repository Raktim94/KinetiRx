# Copy this file to .env (or .env.local) for local development.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of the KinetiRx Go backend API (see ../backend). Defaults to
# http://localhost:8080 in code if unset, so this is only needed when the
# backend runs somewhere else (a different port, a remote/staging server, or
# behind the Docker Compose "backend" service name in production).
VITE_API_URL=http://localhost:8080

# NOTE: GEMINI_API_KEY and any other server-side secrets no longer belong
# here — the frontend is a pure static SPA that talks to the backend over
# HTTP. Server-side secrets (GEMINI_API_KEY, JWT_SECRET,
# KINETIRX_ADMIN_PASSWORD, DATABASE_URL, ...) live in ../backend/.env.example
# instead, and are never bundled into client-side JS.
