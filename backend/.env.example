# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file — it is gitignored below and must stay that way.
# In production, set these as real environment variables / secrets through
# your deployment platform instead of shipping a .env file.

# Postgres connection string. sslmode=disable is fine for local Docker
# Postgres; use sslmode=require (or stronger) against any networked database.
DATABASE_URL=postgres://kinetirx:changeme@localhost:5432/kinetirx?sslmode=disable

# Long, random secret used to sign JWT access tokens. Minimum 16 characters
# enforced at startup; use at least 32 random bytes (e.g. `openssl rand -hex 32`)
# in any real environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Optional. Only consulted on first boot, when the employees table is
# empty: the plaintext password for the seeded "Master Admin" account. It
# is bcrypt-hashed before being stored and is never read again after the
# account exists — safe to remove from the environment after first boot.
# Minimum 8 characters. Leave unset to instead create the admin account
# from the app's own first-run screen (POST /api/auth/setup) — whichever
# happens first wins.
KINETIRX_ADMIN_PASSWORD=

# Optional. When unset, /api/ocr/parse-bill and /api/ai/ask return a
# fallback response instead of calling Gemini.
GEMINI_API_KEY=

# Optional, defaults shown.
PORT=8080
GIN_MODE=release
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
