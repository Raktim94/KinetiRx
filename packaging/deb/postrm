#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "kinetirx: your data stays in Docker volumes (kinetirx_postgres_data) and your settings and generated passwords in /etc/kinetirx/kinetirx.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name kinetirx down -v ; sudo rm -rf /etc/kinetirx" >&2
fi
exit 0
