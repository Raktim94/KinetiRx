# KinetiRx settings. Restart after editing: sudo systemctl restart kinetirx
POSTGRES_PASSWORD=@SECRET@
JWT_SECRET=@SECRET@
# Needed to save secrets from Settings (offsite backup credentials, AI provider key).
BACKUP_ENCRYPTION_KEY=@SECRET@
HTTP_PORT=3080
# Origin(s) the browser uses to open the app, comma-separated (add your LAN address or domain).
ALLOWED_ORIGINS=http://localhost:3080
# Optional: leave blank to create the admin account on the first-run screen.
KINETIRX_ADMIN_PASSWORD=
# Optional: enables AI bill scanning and the clinical assistant. Leave blank to run without them.
GEMINI_API_KEY=
