# Copy to deploy/.env and fill in real values before running:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
# NEVER commit a real deploy/.env file.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=kinetirx
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=kinetirx

# --- Backend -----------------------------------------------------------
# Long, random secret used to sign JWT access tokens (min 16 chars enforced
# at backend startup; use at least 32 random bytes in any real environment,
# e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Plaintext password for the seeded "Master Admin" employee (id
# EMP-ADMIN-1), bcrypt-hashed on first boot and never read again after the
# employees table has at least one row. Minimum 8 characters.
KINETIRX_ADMIN_PASSWORD=change-this-before-first-boot

# Optional. When unset, /api/ocr/parse-bill and /api/ai/ask return a
# fallback response instead of calling Gemini.
GEMINI_API_KEY=

# Optional, default shown.
GIN_MODE=release

# --- Ports published on the host --------------------------------------
# Frontend (the app you actually visit in a browser).
HTTP_PORT=3080
# Backend API, published directly for curl/health-checks/admin scripts —
# the browser SPA itself never needs this since nginx proxies /api/*
# internally. Keep this distinct from HTTP_PORT.
BACKEND_PORT=8080

# --- MCP server (optional, "mcp" Compose profile only) ------------------
# Only needed if you run `docker compose --profile mcp run --rm -T mcp-server`
# (see mcp-server/README.md). Not used by the default postgres+backend+frontend
# stack. Credentials for a real employee account the MCP server logs in as —
# defaults to the seeded admin's id; KINETIRX_ADMIN_PASSWORD above is that
# account's password unless it's since been changed.
KINETIRX_MCP_USERNAME=EMP-ADMIN-1
KINETIRX_MCP_PASSWORD=change-this-before-first-boot
